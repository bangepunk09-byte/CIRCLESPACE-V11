# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

PORT=3000
NODE_ENV=development

# PAYMENT GATEWAY INTEGRATION (Midtrans / Xendit / DOKU)
# Set credentials here on the server to switch from built-in Sandbox Simulator to live API calls.
PAYMENT_GATEWAY_PROVIDER="midtrans"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY=""
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""

# EMAIL OTP VERIFICATION FOR FORGOT PASSWORD (SMTP / Gmail App Password / Resend)
# Optional: Configure SMTP or RESEND_API_KEY to send 6-digit password reset OTP codes via email.
# Google Email Verification works automatically without SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CIRCLE Workspace <no-reply@asliworkspace.tech>"
RESEND_API_KEY=""

